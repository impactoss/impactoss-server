<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <h2>Your Multi-Factor Authentication Code</h2>

    <p>Hi <%= @user.name %>,</p>

    <p>Your authentication code is:</p>

    <h1 style="font-size: 32px; letter-spacing: 4px; font-family: monospace; background-color: #f5f5f5; padding: 15px; text-align: center; border: 2px solid #ddd; border-radius: 4px;">
      <%= @otp_code %>
    </h1>

    <p><strong>This code will expire in 10 minutes.</strong></p>

    <p style="color: #666;">For security reasons, do not share this code with anyone.</p>

    <p style="color: #666;">If you did not request this code, please contact your administrator immediately.</p>
  </body>
</html>
